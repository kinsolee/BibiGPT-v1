# https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-xxx
# Optional: use OpenAI-compatible providers (falls back to OPENAI_API_KEY)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_PROVIDER_NAME=openai-compatible
# Optional: allow custom user-entered API key prefixes, comma-separated (e.g. "sk-,rk-")
OPENAI_COMPATIBLE_KEY_PREFIXES=
# Optional: override the model catalog endpoint (OpenAI-compatible {data:[{id}]} format); defaults to OpenRouter.
# The provider API key is only sent to the catalog when it shares the provider's origin.
MODEL_CATALOG_URL=
# Optional: dedicated credential for MODEL_CATALOG_URL when it is hosted elsewhere
MODEL_CATALOG_API_KEY=

# https://www.bilibili.com
BILIBILI_SESSION_TOKEN=

# https://savesubs.com
SAVESUBS_X_AUTH_TOKEN=

# https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_RATE_REDIS_REST_URL=${UPSTASH_REDIS_REST_URL}
UPSTASH_RATE_REDIS_REST_TOKEN=${UPSTASH_REDIS_REST_TOKEN}

# https://supabase.com/docs/reference/javascript/initializing
SUPABASE_HOSTNAME=xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://${SUPABASE_HOSTNAME}


############ Optional #################

# https://docs.sentry.io/product/cli/configuration
SENTRY_AUTH_TOKEN=

# https://www.lemonsqueezy.com
LEMON_API_KEY=

# https://segment.com
NEXT_PUBLIC_SEGMENT_WRITEKEY=

NEXT_PUBLIC_SITE_URL=
INTERNAL_API_HOSTNAME=https://api.example.com

############ KIN-46: local upload / ASR / podcast（新增来源） ############
# 本地上传根目录（仓库外，fileId 绑定）；缺省 ~/.bibigpt-uploads
BIBI_UPLOAD_DIR=
# 上传/ingest API 令牌；未配置时仅允许本机回环访问
BIBI_UPLOAD_TOKEN=
# 单文件上传上限（字节），缺省 4GB
BIBI_MAX_UPLOAD_BYTES=
# Whisper 兼容 ASR 端点；缺省回落 OPENAI_COMPATIBLE_* / OPENAI_API_KEY
BIBI_ASR_BASE_URL=
BIBI_ASR_API_KEY=
BIBI_ASR_MODEL=
# ASR 语言提示（ISO 639-1，如 zh/en）；留空自动检测
BIBI_ASR_LANGUAGE=
# 无字幕 YouTube 抽音轨用的 yt-dlp 路径；缺省 PATH 上的 yt-dlp
BIBI_YTDLP_PATH=
# 播客 feed 白名单追加主机（逗号分隔）
BIBI_PODCAST_EXTRA_HOSTS=

############ KIN-47: export pipeline（统一导出与集成） ############
# 服务端主密钥：AES-256-GCM 加密 webhook/API secret，并用于下载链接签名（32+ 字符随机串）
EXPORT_SECRET_KEY=
# Notion 集成凭据（真实实现走 env）：内部集成 token 与目标 database id
NOTION_TOKEN=
NOTION_DATABASE_ID=
# 飞书文档集成凭据（真实实现走 env）：自建应用 id/secret 与可选文件夹 token
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOC_FOLDER_TOKEN=
# PDF 渲染用 TTF/OTF 字体路径（可选；缺省自动探测常见系统中文字体，回落 Helvetica）
BIBI_EXPORT_PDF_FONT=

############ KIN-48: vision keyframes / VLM（视觉理解） ############
# 场景切分阈值 0..1（ffmpeg select=gt(scene,T)），缺省 0.3
BIBI_VISION_SCENE_THRESHOLD=
# 单条视频最多保留关键帧数（1..120），缺省 24
BIBI_VISION_MAX_FRAMES=
# 相邻关键帧最小间隔秒（0..600），缺省 2
BIBI_VISION_MIN_GAP_SECONDS=
# 关键帧 JPEG 输出根目录；缺省 ~/.bibigpt-vision
BIBI_VISION_DIR=
# VLM 视觉模型（OpenAI 兼容）；缺省回落 OPENAI_COMPATIBLE_MODEL
BIBI_VISION_MODEL=
# 单帧 VLM 调用超时毫秒，缺省 60000
BIBI_VISION_TIMEOUT_MS=
# 音频-only 笔记插图开关（true 开启；缺省关闭）
BIBI_VISION_AUDIO_ILLUSTRATIONS=
# 批量画面分析的 VLM 并发数（1..8），缺省 3
BIBI_VISION_ANALYZE_CONCURRENCY=
# 批量分析整体时限毫秒（须小于 route maxDuration 300s），缺省 240000
BIBI_VISION_BATCH_DEADLINE_MS=

############ KIN-49: v1 public API / browser extension ############
# v1 API 专用 service role key（api_tokens 哈希查找与按 token.user_id 隔离的业务查询）；不配置则 /api/v1 鉴权不可用
SUPABASE_SERVICE_ROLE_KEY=
# v1 管理面令牌（新建/撤销 API token）；未配置时管理面一律 403
BIBI_V1_ADMIN_TOKEN=
# 管理面创建 token 时缺省绑定的 Supabase user id（单用户自用可配一次）
BIBI_API_DEFAULT_USER_ID=
# v1 API 每 token 每分钟请求上限，缺省 120
BIBI_V1_RATE_LIMIT_PER_MINUTE=
